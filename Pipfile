[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
# Core Framework
pygobject = ">=3.58.1"

# Speech-to-Text
openai-whisper = ">=20250625"
torch = ">=2.15.0"
torchaudio = ">=2.11.1"

# OpenVINO (Intel NPU/GPU/CPU)
openvino = "*"
openvino-genai = "*"

# Audio Input/Output
sounddevice = ">=0.5.6"
numpy = ">=2.5.4,<3.0.0"

# Text-to-Speech
piper-tts = "*"
pyttsx3 = ">=2.99"

# LLM APIs (optional cloud fallback)
openai = ">=3.42.1"
anthropic = ">=2.3.0"

# Configuration
pyyaml = ">=6.0.3"
jsonschema = ">=4.26.0"

# Model downloads
huggingface_hub = "*"

# Utilities
importlib-metadata = ">=10.1.0"

[dev-packages]
black = "*"
flake8 = "*"
pytest = "*"

[requires]
python_version = "3.12"
